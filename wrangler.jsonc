// Cloudflare Workers deploy settings for sctmgdatadisc.com.
//
// Static files (index.html, api/v1) are served straight from the repo root.
// Only /auth/* and /sync/* run the Worker in worker/index.js (Discord sign-in,
// roster sync, share links, online games), which stores data in D1.
// .assetsignore keeps dev files off the live site; _headers opens the static
// API to browser apps on other origins (CORS).
//
// Set in the Cloudflare dashboard, never in this file:
//   - the custom domain (Worker > Settings > Domains & Routes)
//   - the secret DISCORD_CLIENT_SECRET (Worker > Settings > Variables and Secrets)
{
  "name": "sctmg-data-disc",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/auth/*", "/sync/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sctmg-data-disc",
      "database_id": "77d818c1-b75d-4fe5-89f4-bf34e0148b6e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public OAuth client ID from the Discord Developer Portal (not a secret).
    "DISCORD_CLIENT_ID": "1574597217497382932"
  },
  "observability": { "enabled": true }
}
