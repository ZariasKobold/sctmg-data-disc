# Files Cloudflare should NOT publish (gitignore syntax).
# The live site only needs index.html, api/, _headers and the installable-app
# files (manifest.webmanifest, sw.js, icons/). art/ holds the full-size source
# images that scripts/build-icons.mjs shrinks into icons/.
.git
.github
.gitignore
.assetsignore
.wrangler
node_modules
Docs
tests
scripts
art
package.json
package-lock.json
wrangler.jsonc
*.md
worker
migrations
.dev.vars
