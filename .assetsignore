# files (manifest.webmanifest, sw.js, icons/).
.git
.github
.gitignore
.assetsignore
.wrangler
node_modules
Docs
tests
scripts
package.json
package-lock.json
wrangler.jsonc
*.md
worker
migrations
.dev.vars
